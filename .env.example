# Copiá a .env.local (local) y cargá las mismas en Vercel > Settings > Environment Variables.
# NUNCA subas .env.local a GitHub. Ninguna lleva NEXT_PUBLIC_.

# Google OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth > Aplicación web)
# URIs de redireccionamiento autorizados:
#   https://avalanche-track.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# next-auth
NEXTAUTH_URL=http://localhost:3000
# Mínimo 32 caracteres. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# MongoDB Atlas (con la base en la ruta)
MONGO_URI=
MONGO_DB=builders

NEXT_PUBLIC_SKILLS_REPO=
