# Copiá a .env.local (local) y cargá las mismas en Vercel > Settings > Environment Variables.
# NUNCA subas .env.local a GitHub.

# Google OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth > Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que coincidir EXACTO con un "URI de redireccionamiento autorizado".
#   producción: https://avalanche-track.vercel.app/callback
#   local:      http://localhost:3000/callback
CALLBACK_URL=http://localhost:3000/callback

# MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=builders

# Firma de la cookie de sesión (mínimo 32 caracteres). Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

NEXT_PUBLIC_SKILLS_REPO=
